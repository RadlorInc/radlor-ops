# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.

# Supabase project (Settings → API). NOT prefixed NEXT_PUBLIC_: the browser never talks to
# Supabase in this app, so nothing about the project needs to reach the bundle.
SUPABASE_URL=https://<project-ref>.supabase.co

# ⚠️ SERVER-ONLY. This key bypasses RLS. It must NEVER be given a NEXT_PUBLIC_ prefix and must
# never appear in a client component. On Vercel, set it for Production/Preview/Development and
# leave "Automatically expose" off.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Gate for /admin and /admin/export, passed as ?k=<value>. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Unset = the admin surface is closed, not open.
ADMIN_TOKEN=<long random string>
